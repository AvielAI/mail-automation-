# Flask core
FLASK_SECRET_KEY=change-me-in-production-use-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=false

# Google OAuth2 — create credentials at https://console.cloud.google.com/
# OAuth2 client type: Web Application
# Authorised redirect URIs must include: http://localhost:5000/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Storage
DATA_DIR=/tmp/insurance_data
STORAGE_MODE=ephemeral   # ephemeral | persistent

# Session
SESSION_COOKIE_SECURE=false   # set true in production (HTTPS)
SESSION_COOKIE_SAMESITE=Lax

# Optional: override default Gmail search query
# GMAIL_SEARCH_QUERY=subject:(ביטוח OR insurance OR פוליסה OR policy)

# Optional: OCR control (set false to skip even if tesseract present)
# OCR_ENABLED=true
